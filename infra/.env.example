# Copy to infra/.env and fill in. Compose reads that file automatically.
# Never commit the real one: it is git-ignored, and the deploy job never copies it.

# Letters and digits only: it goes inside a connection URL, where @ / : or # would break it.
# openssl rand -hex 32 produces one.
POSTGRES_PASSWORD=

# Signs sessions. openssl rand -hex 32 produces one. Changing it signs everyone out.
BETTER_AUTH_SECRET=

# Where people reach the app. On a server: the https:// address, and leave TRUSTED_ORIGINS
# empty, since the Vite servers it lists only exist on a development machine.
PUBLIC_URL=http://localhost:8080
# TRUSTED_ORIGINS=

# Mailpit catches mail locally. On a server, a real provider's SMTP URL and sender address.
# SMTP_URL=smtp://user:password@smtp.example.com:587
# MAIL_FROM=Pipeline Lab <no-reply@example.com>

# Only for running the end-to-end tests against this stack. Never set it on a server.
# RATE_LIMIT=off

# Google sign-in is optional. Leave both blank and the button stays hidden.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# MinIO's defaults locally. On a server these become the Cloudflare R2 credentials.
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
